# Rockchip RK3582 with Cortex-A76 and Cortex-A55 cores
# Use the ARMv8.0 baseline and no CPU-specific instruction tuning.
APK_ARCH=aarch64_generic
ARCH_CFLAGS="-march=armv8-a -mtune=cortex-a76 -O2"
GOARM64=v8.0
APK_SIGNING_KEY_NAME=incus-openwrt-rk3582.pem
TARGET_DESCRIPTION="Rockchip RK3582 (Cortex-A76/A55)"
