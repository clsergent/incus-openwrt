# Shared build and dependency configuration
ALPINE_VERSION=3.24
GO_VERSION=1.24.4
INCUS_VERSION=7.0.1
EUDEV_VERSION=3.2.14
DBUS_VERSION=1.14.10
ATTR_VERSION=2.5.2
SQUASHFS_VERSION=4.6.1
XZ_VERSION=5.6.3

GOARCH=arm64
GOARM64=v8.0
ARCH_CFLAGS="-O2"
APK_ARCH=aarch64_generic
OUT_DIR=/output
PKG_DIR=/output/pkg
INCUS_INITD=/build/incus.initd
APK_REVISION=0
APK_SIGNING_KEY_NAME=incus-openwrt.pem
TARGET_DESCRIPTION="generic ARM64"
